[Unit]
Description=词境 Lexica 学生版后端（带登录）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_USER@
WorkingDirectory=@INSTALL_DIR@
Environment=WP_HOST=127.0.0.1
Environment=WP_PORT=@PORT@
Environment=WP_DB=@DATA_DIR@/app.db
Environment=WP_QUIET=1
# 老表里的时间是不带时区的字符串，按北京时间写才和用户看到的一致（新的访问记录表存 UTC 秒数，不受影响）
Environment=TZ=Asia/Shanghai
# 登录功能和安全相关设置：站点只通过 HTTPS 对外（Tailscale Funnel），所以 Cookie 必须带 Secure
Environment=WP_AUTH=1
# 内网入口允许不登录做题（只有 nginx 的内网入口会打 X-Wp-Entry 标记；1 = 开，0 = 关）
Environment=WP_LAN_GUEST=@LAN_GUEST@
# 我们自己信任的前置代理（例如 pvehost 的 nginx）：访问记录里跳过它们，记真正的访客 IP
Environment=WP_TRUSTED_PROXIES=@TRUSTED_PROXIES@
Environment=WP_COOKIE_SECURE=1
Environment=WP_SESSION_DAYS=14
# 对外地址由配置决定，不信客户端传来的 Host / X-Forwarded-Host（离线页里「返回主页」链接用它）
Environment=WP_PUBLIC_HOME_URL=@PUBLIC_URL@
Environment=WP_EDGE_TTS=@TTS_VENV@/bin/edge-tts
Environment=WP_TTS_VOICE=en-US-AriaNeural
ExecStart=/usr/bin/python3 -m server.app
Restart=on-failure
RestartSec=3

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DATA_DIR@ @INSTALL_DIR@/var
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
