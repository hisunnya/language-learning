<view class="app theme-{{theme}}">
  <view class="hud">
    <view class="hud-row">
      <view class="stat">
        <text class="k">{{t.hudTime}}</text>
        <text class="v {{timeWarn ? 'v-warn' : 'v-time'}}">{{timeLeft}}</text>
      </view>
      <view class="stat">
        <text class="k">{{t.hudScore}}</text>
        <text class="v v-score">{{score}}</text>
      </view>
      <view class="stat">
        <text class="k">{{t.hudBest}}</text>
        <text class="v">{{best}}</text>
      </view>
    </view>
    <view class="progress">
      <view class="progress-i {{timeWarn ? 'progress-warn' : ''}}" style="width:{{timePct}}%"></view>
    </view>
    <view class="ptext">
      <text class="ptext-lv">{{levelLine}}</text>
      <text>{{matched}}/{{total}}</text>
    </view>
  </view>

  <view class="board">
    <view
      wx:for="{{cards}}"
      wx:key="key"
      class="{{item.cls}}"
      data-id="{{item.id}}"
      data-t="{{item.t}}"
      bindtap="onTapCard"
    >
      <text class="tag">{{item.t === 'en' ? 'EN' : 'CN'}}</text>
      <text class="w">{{item.text}}</text>
      <text class="ipa" wx:if="{{item.ipa}}">{{item.ipa}}</text>
      <text class="say" wx:if="{{audioOn && item.t === 'en'}}">🔊</text>
    </view>
  </view>

  <view class="fx" wx:if="{{fxShow}}">{{fxText}}</view>

  <view class="bar">
    <view class="btn btn-ghost bar-btn" hover-class="btn-pressed" bindtap="onShowRules">{{t.btnRules}}</view>
    <view class="btn btn-ghost bar-btn" hover-class="btn-pressed" bindtap="onReplay">{{t.btnReplay}}</view>
    <view class="btn btn-warn bar-btn" hover-class="btn-pressed" bindtap="onRestartAll">{{t.btnRestart}}</view>
  </view>
</view>

<view class="overlay theme-{{theme}}" wx:if="{{overlay === 'clear'}}">
  <view class="panel">
    <text class="panel-title">{{t.clearTitle}}</text>
    <text class="panel-score">{{overlayScore}}</text>
    <view class="kv">
      <text>{{t.clearBonus}}</text>
      <text class="kv-b">+{{overlayBonus}}</text>
    </view>
    <view class="kv">
      <text>{{t.clearNext}}</text>
      <text class="kv-b">{{overlayNextBonusText}}</text>
    </view>
    <view class="panel-actions">
      <view class="btn btn-ghost" hover-class="btn-pressed" bindtap="onFinish">{{t.btnFinish}}</view>
      <view class="btn" hover-class="btn-pressed" bindtap="onNextLevel" wx:if="{{overlayHasNext}}">{{t.btnNextLevel}}</view>
      <view class="btn" hover-class="btn-pressed" bindtap="onFinish" wx:else>{{t.btnTotal}}</view>
    </view>
  </view>
</view>

<view class="overlay theme-{{theme}}" wx:if="{{overlay === 'over'}}">
  <view class="panel">
    <text class="panel-title">{{t.overTitle}}</text>
    <text class="panel-sub">{{t.overSub}}</text>
    <text class="panel-score">{{overlayScore}}</text>
    <view class="panel-actions">
      <view class="btn btn-ghost" hover-class="btn-pressed" bindtap="onRestartAll">{{t.btnRestart}}</view>
      <view class="btn" hover-class="btn-pressed" bindtap="onReplay">{{t.btnReplay}}</view>
    </view>
  </view>
</view>
