.page {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
}

.hero {
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(140deg, #4f46e5, #7c6cf0 55%, #f0a03c);
}

.brand-text {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.brand-sub {
  font-size: 18rpx;
  letter-spacing: 6rpx;
  color: var(--game-muted);
}

.title {
  margin-top: 28rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--game-muted);
}

.tabs {
  display: flex;
  margin-top: 36rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: var(--game-chip);
}

.tab {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--game-muted);
}

.tab-on {
  background: var(--game-card);
  color: var(--game-primary);
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(30, 64, 120, 0.12);
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 4rpx 20rpx;
}

.summary-text {
  font-size: 26rpx;
  color: var(--game-muted);
}

.summary-rule {
  font-size: 26rpx;
  color: var(--game-primary);
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 99rpx;
  background: var(--game-bg-en);
}

.start-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #4f46e5, #6d5ce8);
  box-shadow: 0 10rpx 26rpx rgba(79, 70, 229, 0.28);
}

.start-card-on {
  transform: translateY(2rpx);
  opacity: 0.94;
}

.start-left {
  display: flex;
  flex-direction: column;
}

.start-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.start-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.start-arrow {
  font-size: 40rpx;
  color: #ffffff;
  opacity: 0.9;
}

.unit-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 20rpx;
}

.unit {
  width: 48.6%;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 22rpx;
  background: var(--game-card);
  border: 2rpx solid var(--game-line-en);
  box-shadow: 0 4rpx 14rpx rgba(30, 64, 120, 0.06);
}

.unit-on {
  background: var(--game-bg-en);
}

.unit-name {
  font-size: 30rpx;
  font-weight: 700;
}

.unit-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--game-muted);
}

.footnote {
  display: block;
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--game-muted);
  opacity: 0.8;
}
