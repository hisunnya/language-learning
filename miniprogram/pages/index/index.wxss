.page {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
  background: var(--game-page);
  color: var(--game-ink);
}

.hero {
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--game-on-primary);
  background: linear-gradient(140deg, var(--game-brand-a), var(--game-brand-b) 55%, var(--game-brand-c));
}

.brand-text {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.brand-sub {
  font-size: 18rpx;
  letter-spacing: 6rpx;
  color: var(--game-muted);
}

.title {
  margin-top: 28rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--game-muted);
}

.tabs {
  display: flex;
  margin-top: 36rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: var(--game-chip);
}

.tab {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--game-muted);
}

.tab-on {
  background: var(--game-card);
  color: var(--game-primary);
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx var(--game-shadow);
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 4rpx 20rpx;
}

.summary-text {
  font-size: 26rpx;
  color: var(--game-muted);
}

.summary-rule {
  font-size: 26rpx;
  color: var(--game-primary);
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 99rpx;
  background: var(--game-bg-en);
}

.start-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--game-primary), var(--game-primary-2));
  box-shadow: 0 10rpx 26rpx var(--game-start-shadow);
}

.start-card-on {
  transform: translateY(2rpx);
  opacity: 0.94;
}

.start-left {
  display: flex;
  flex-direction: column;
}

.start-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--game-on-primary);
}

.start-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--game-on-primary);
  opacity: 0.82;
}

.start-arrow {
  font-size: 40rpx;
  color: var(--game-on-primary);
  opacity: 0.9;
}

.unit-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 20rpx;
}

.unit {
  width: 48.6%;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 22rpx;
  background: var(--game-card);
  border: 2rpx solid var(--game-line-en);
  box-shadow: 0 4rpx 14rpx var(--game-shadow);
}

.unit-on {
  background: var(--game-bg-en);
}

.unit-name {
  font-size: 30rpx;
  font-weight: 700;
}

.unit-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--game-muted);
}

.footnote {
  display: block;
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--game-muted);
  opacity: 0.8;
}

/* ---------- 顶部：品牌 + 语言切换 + 配色方块 ---------- */
.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.controls {
  display: flex;
  align-items: center;
}

.lang-btn {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 99rpx;
  border: 2rpx solid var(--game-line-en);
  background: var(--game-card);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--game-muted);
}

.lang-btn .on {
  color: var(--game-primary);
}

.lang-btn .sep {
  margin: 0 6rpx;
  opacity: 0.5;
}

.swatches {
  display: flex;
  align-items: center;
  margin-left: 12rpx;
}

/* 触控区比方块大一圈，方块本身保持小而方 */
.swatch-hit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
}

.swatch {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--game-line-en);
  /* 左下 = 页面底色，右上 = 强调色，两色硬切 */
  background: linear-gradient(to top right, var(--swatch-bg) 50%, var(--swatch-main) 50%);
}

.swatch-on {
  box-shadow: 0 0 0 4rpx var(--game-card), 0 0 0 7rpx var(--game-primary);
}

.palette-name {
  display: block;
  margin-top: 6rpx;
  text-align: right;
  font-size: 20rpx;
  color: var(--game-muted);
}
