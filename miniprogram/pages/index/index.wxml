<view class="page theme-{{theme}}">
  <view class="hero">
    <view class="hero-top">
      <view class="brand">
        <view class="brand-mark">词</view>
        <view class="brand-text">
          <text class="brand-name">{{t.brandName}}</text>
          <text class="brand-sub">LEXICA</text>
        </view>
      </view>
      <view class="controls">
        <view
          class="lang-btn"
          hover-class="btn-pressed"
          aria-role="button"
          aria-label="{{t.langAria}}"
          bindtap="onToggleLang"
        >
          <text class="{{lang === 'zh' ? 'on' : ''}}">中</text>
          <text class="sep">/</text>
          <text class="{{lang === 'en' ? 'on' : ''}}">EN</text>
        </view>
        <view class="swatches" aria-role="group" aria-label="{{t.paletteLabel}}">
          <view
            class="swatch-hit"
            wx:for="{{palettes}}"
            wx:key="key"
            data-key="{{item.key}}"
            aria-role="button"
            aria-label="{{item.name}}"
            bindtap="onPickTheme"
          >
            <view class="swatch {{item.on ? 'swatch-on' : ''}}" style="{{item.style}}"></view>
          </view>
        </view>
      </view>
    </view>
    <text class="palette-name">{{themeName}}</text>
    <text class="title">{{t.title}}</text>
    <text class="subtitle">{{t.subtitle}}</text>
  </view>

  <view class="tabs">
    <view
      class="tab {{bookIndex === index ? 'tab-on' : ''}}"
      wx:for="{{bookTabs}}"
      wx:key="key"
      data-index="{{index}}"
      bindtap="onSwitchBook"
    >{{item.name}}</view>
  </view>

  <view class="summary">
    <text class="summary-text">{{summaryText}}</text>
    <text class="summary-rule" bindtap="onShowRules">{{t.rules}}</text>
  </view>

  <view class="start-card" hover-class="start-card-on" bindtap="onStartAll">
    <view class="start-left">
      <text class="start-title">{{t.startAll}}</text>
      <text class="start-desc">{{t.startAllDesc}}</text>
    </view>
    <view class="start-arrow">→</view>
  </view>

  <view class="unit-list">
    <view
      class="unit"
      hover-class="unit-on"
      wx:for="{{units}}"
      wx:key="index"
      data-index="{{item.index}}"
      bindtap="onStartUnit"
    >
      <view class="unit-name">{{item.name}}</view>
      <view class="unit-meta">{{item.meta}}</view>
    </view>
  </view>

  <text class="footnote">{{t.noteGrade}}</text>
  <text class="footnote">{{t.copyright}}</text>
</view>
