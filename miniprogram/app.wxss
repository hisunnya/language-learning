page {
  min-height: 100%;
  background: var(--game-page);
  color: var(--game-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", sans-serif;
  -webkit-text-size-adjust: 100%;
}

view,
text {
  box-sizing: border-box;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  font-size: 29rpx;
  font-weight: 700;
  color: var(--game-on-primary);
  background: var(--game-primary);
  box-shadow: 0 6rpx 0 var(--game-primary-dark);
}

.btn-ghost {
  color: var(--game-muted);
  background: var(--game-card);
  box-shadow: 0 6rpx 0 var(--game-line-en);
}

.btn-warn {
  background: var(--game-warn);
  box-shadow: 0 6rpx 0 var(--game-warn-dark);
}

.btn-pressed {
  transform: translateY(4rpx);
  box-shadow: none;
}
