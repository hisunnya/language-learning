# macOS
.DS_Store

# Windows / Office 临时文件
Thumbs.db
~$*
.~lock.*

# 备份文件
*.bak
*.orig
*.rej

# 写到一半、还没做完的脚本或用例（文件名带 .wip）：留着参考，但不会被测试发现、也不会误提交
*.wip

# git filter-repo 重写历史时留下的备份目录（AGENTS.md §1：重写已发布的历史要主人同意）
.git-rewrite/

# 编辑器
.vscode/
.idea/
*.swp

# 小程序开发工具的工作区元数据
miniprogram/.workbuddy/

# Python
__pycache__/
*.py[cod]

# word-puzzle 运行期数据（数据库、生成的离线测试页、上传的资料）
word-puzzle/var/

# ECDICT 词典（体积大，需要时用 tools/build_seed_data.py --ecdict 临时下载）
word-puzzle/data/raw/ecdict.csv

# 真实数据永远不进仓库（仓库在 GitHub 上是公开的）：数据库、名单、初始密码清单、备份、密钥
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.pem
*.key
.env
.env.*
*名单*
*初始密码*
*credentials*
*roster*.xlsx
*roster*.csv
backups/
lexica-data/
lexica-backup/

# 部署时用的私有地址（真实值只存在本机和服务器上）
deploy.local.env
AGENTS.local.md
.private-patterns
